# Required
POSTONCE_API_KEY=
POSTONCE_BASE_URL=https://postonce.to/api/public/v1
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=development

# Optional post publish callback delivery
POST_PUBLISH_CALLBACK_URL=
POST_PUBLISH_CALLBACK_BEARER=

# Optional post publish watcher
POST_PUBLISH_WATCHER_INTERVAL_MS=15000
POST_PUBLISH_WATCHER_BATCH_SIZE=20
POST_PUBLISH_WATCHER_SECRET=

# Optional bulk publish tuning
BULK_PUBLISH_ACCOUNT_POST_CONCURRENCY=
BULK_PUBLISH_RUN_CONCURRENCY=
BULK_PUBLISH_STALE_RUN_GRACE_MS=300000
BULK_PUBLISH_WATCHDOG_INTERVAL_MS=30000
BULK_PUBLISH_MAX_RETRY_ATTEMPTS=5
BULK_PUBLISH_STANDARD_CONCURRENCY=
BULK_PUBLISH_PROGRESS_FLUSH_INTERVAL_MS=1000
BULK_PUBLISH_PROGRESS_FLUSH_BATCH_SIZE=20
BULK_PUBLISH_CONTROL_POLL_INTERVAL_MS=1000
